# ---------------------------------------------------------------------------
# Merqo - copy to .env and fill in real values. .env is git-ignored.
# Nothing in this file is a real secret; every value is a placeholder.
#
# Every name below is read by the backend or by the Vite dev server. The
# backend reads the environment variables of the first blocks, the frontend
# reads the ones in the last blocks.
# ---------------------------------------------------------------------------

# ---- Application mode ------------------------------------------------------
# true  = demo mode (demo accounts, seeded data, one click login)
# false = real use (first owner created from INITIAL_OWNER_* below)
DEMO_MODE=true

# ---- Database --------------------------------------------------------------
# Local development (scripts/setup-db.bat creates these):
#   DATABASE_URL=jdbc:postgresql://localhost:5432/merqo
#   DB_USER=postgres
#   DB_PASSWORD=postgres
#
# Supabase (hosted, free tier). Use the SESSION MODE pooler, not transaction
# mode: session mode keeps prepared statements and row locking working.
#   DATABASE_URL=jdbc:postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#   DB_USER=postgres.PROJECT_REF
#   DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
DATABASE_URL=jdbc:postgresql://localhost:5432/merqo
DB_USER=postgres
DB_PASSWORD=postgres
# Optional: the schema, when it is not "public".
# DB_SCHEMA=public
# The test suite runs against its own database.
# TEST_DATABASE_URL=jdbc:postgresql://localhost:5432/merqo_test
# TEST_DB_USER=postgres
# TEST_DB_PASSWORD=postgres
# The size of the connection pool. Five is enough for the free tier.
# DB_POOL_MAX_SIZE=5

# ---- Server / CORS ---------------------------------------------------------
# Public port. Render injects PORT automatically; leave empty locally.
PORT=8080
# Comma-separated list of browser origins allowed to call the API.
# With the Cloudflare Pages proxy the browser only ever calls its own origin,
# so this is mainly for local development (http://localhost:5173).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- Session ---------------------------------------------------------------
# The name of the session cookie. It is host only, so it never leaves the site.
SESSION_COOKIE_NAME=MERQO_SESSION
# How long a session may sit unused, and how long it may live in total.
SESSION_IDLE_TIMEOUT_MINUTES=480
SESSION_ABSOLUTE_TIMEOUT_MINUTES=720
# The Secure flag on the session cookie. It is on in the prod profile, because
# the deployed site is only reached over HTTPS. Leave it off locally, or the
# browser refuses the cookie on http://localhost.
SESSION_SECURE_COOKIE=false

# ---- Integration modes -----------------------------------------------------
# Each integration has a mock implementation and a live adapter.
# mock = no external account needed (safe for demo and for development).
# Courier adapters: mock | pathao | steadfast
COURIER_MODE=mock
# Payment verification mode: manual (staff manual verify) | mock (demo/test provider check) | live (reserved; fails fast on startup)
PAYMENT_MODE=manual
# Website order sources: mock | generic
WEBSITE_MODE=mock
# AES-GCM master key (any strong 32+ char string) used to encrypt integration client secrets
INTEGRATION_SECRET_KEY=CHANGE_ME_STRONG_INTEGRATION_MASTER_KEY
# AI assistant: mock | <provider> (built in Prompt 9)
LLM_MODE=mock

# ---- First owner (used when DEMO_MODE=false) --------------------------------
# The owner is created when the username and the password are set and no owner
# exists yet. The owner must change the password at the first sign in.
INITIAL_OWNER_USERNAME=owner
INITIAL_OWNER_EMAIL=owner@example.com
INITIAL_OWNER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Only for a one-off password reset. Remove it again right after the restart.
# RESET_OWNER_PASSWORD_ON_START=false

# ---- Logging ---------------------------------------------------------------
# INFO, DEBUG or WARN. The dev profile already turns on DEBUG for com.merqo.
# MERQO_LOG_LEVEL=INFO

# ---- Frontend build-time configuration ------------------------------------
# The backend the Vite dev server proxies /api to. The browser never calls this
# address directly: it always calls its own origin.
VITE_API_PROXY_TARGET=http://localhost:8080
# The ports of the dev server and of the preview server.
# VITE_PORT=5173
# VITE_PREVIEW_PORT=4173

# ---- Free uptime monitor ---------------------------------------------------
# A monitor that hits /api/v1/health/ping every 10 minutes keeps the free
# Render web service awake (it sleeps after 15 idle minutes).
UPTIME_PING_URL=
