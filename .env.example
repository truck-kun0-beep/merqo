# ---------------------------------------------------------------------------
# Merqo - copy to .env and fill in real values. .env is git-ignored.
# Nothing in this file is a real secret; every value is a placeholder.
# ---------------------------------------------------------------------------

# ---- Application mode ------------------------------------------------------
# true  = demo mode (demo accounts, seeded data, demo console, demo banner)
# false = real use (first owner created from INITIAL_OWNER_* below)
DEMO_MODE=true

# ---- Database --------------------------------------------------------------
# Local development (scripts/setup-db.bat creates these):
#   DATABASE_URL=jdbc:postgresql://localhost:5432/merqo
#   DB_USER=postgres
#   DB_PASSWORD=postgres
#
# Supabase (hosted, free tier). Use the SESSION MODE pooler, not transaction
# mode: session mode keeps prepared statements and row locking working.
#   DATABASE_URL=jdbc:postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#   DB_USER=postgres.PROJECT_REF
#   DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
# Optional: set the schema explicitly if you use a non-public schema.
# DB_SCHEMA=public
DATABASE_URL=jdbc:postgresql://localhost:5432/merqo
DB_USER=postgres
DB_PASSWORD=postgres

# ---- Server / CORS ---------------------------------------------------------
# Public port. Render injects PORT automatically; leave empty locally.
PORT=8080
# Comma-separated list of browser origins allowed to call the API.
# With the Cloudflare Pages proxy the browser only ever calls its own origin,
# so this is mainly for local development (http://localhost:5173).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- Integration modes -----------------------------------------------------
# Each integration has a mock implementation and a live adapter.
# mock = no external account needed (safe for demo and for development).
# Courier adapters: mock | pathao | steadfast
COURIER_MODE=mock
# Payment adapters: mock | manual
PAYMENT_MODE=mock
# Website order sources: mock | generic
WEBSITE_MODE=mock
# AI assistant: mock | <provider> (built in Prompt 9)
LLM_MODE=mock

# ---- First owner (used when DEMO_MODE=false, Prompt 1) ---------------------
INITIAL_OWNER_EMAIL=owner@example.com
INITIAL_OWNER_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- Frontend build-time configuration ------------------------------------
# Absolute URL of the Merqo backend, used by the Cloudflare Pages proxy.
# e.g. https://merqo-api.onrender.com
VITE_API_BASE_URL=http://localhost:8080

# ---- Free uptime monitor ---------------------------------------------------
# A monitor that hits /api/v1/health/ping every 10 minutes keeps the free
# Render web service awake (it sleeps after 15 idle minutes).
UPTIME_PING_URL=
