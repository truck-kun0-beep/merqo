# ---- Java / Maven ----
target/
*.class
*.jar
!**/.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties
*.log
hs_err_pid*

# ---- Node / Frontend ----
node_modules/
dist/
dist-ssr/
coverage/
.vite/
*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- IDE ----
.idea/
*.iml
